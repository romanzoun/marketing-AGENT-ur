#!/usr/bin/env bash
# Health-Check: Edge-Debug-Port, LinkedIn-Session, Codex CLI.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT/src"
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
cd "$ROOT"
exec "$PY" scripts/healthcheck.py "$@"
