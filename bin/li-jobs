#!/usr/bin/env bash
# Job-Runner für Freigabe → Einplanung → automatische Veröffentlichung.
# Nutzung:  ./bin/li-jobs --campaign "Kampagnen/<x>/kampagne.yaml" <job> [...]
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT/src"
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
cd "$ROOT"
exec "$PY" -m linkedin_agents.jobs "$@"
