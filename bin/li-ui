#!/usr/bin/env bash
# Sara's Marketing AGENT-ur — Weboberfläche starten.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT/src"
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
cd "$ROOT"
exec "$PY" -m linkedin_agents.web.app "$@"
