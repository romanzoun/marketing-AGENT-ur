#!/usr/bin/env bash
# Einziger Cron-Einstieg: prüft automation/jobs.yaml und führt fällige, aktive Jobs aus.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT/src"
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
cd "$ROOT"
exec "$PY" -m linkedin_agents.scheduler "$@"
