<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.linkedin-automation.browser</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/scripts/start-linkedin-browser-macos.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/linkedin-automation-browser.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/linkedin-automation-browser.error.log</string>
</dict>
</plist>
