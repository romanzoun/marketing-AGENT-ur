# Playwright / laufende Edge- oder Chrome-Session (CDP).
# Docker überschreibt diesen Wert intern mit http://host.docker.internal:9222.
# Browser-Start: siehe INSTALLATION.md und scripts/start-linkedin-browser-*.{sh,ps1}
CDP_ENDPOINT=http://localhost:9222

LOG_LEVEL=INFO

# Globale Ausführungsgrenze für alle automatischen und manuellen Jobs.
WORKING_HOURS_START=08:00
WORKING_HOURS_END=17:00

# Fester Abstand vor finalen LinkedIn-Schreibaktionen (0 bis 10000 ms).
LINKEDIN_ACTION_DELAY_MS=2000

# Bildgenerierung (optional). Den Key ausschließlich in der lokalen .env eintragen.
#   none   = kein echtes Bild, es wird nur ein Bild-Brief als .txt gespeichert
#   openai = Bild via OpenAI Images API (OPENAI_API_KEY erforderlich)
IMAGE_PROVIDER=none
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# Optional für private GitHub-Updates. Niemals committen.
GITHUB_TOKEN=
